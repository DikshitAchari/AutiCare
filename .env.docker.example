# =================================================================
# AutiCare Docker Compose Environment Configuration
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# =================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auticare_db
DB_PORT=5432

# Backend API Configuration
APP_NAME="AutiCare API"
APP_ENV=production
DEBUG=false
SECRET_KEY=auticare_production_secret_key_change_me_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173
MAX_VIDEO_UPLOAD_MB=100
OPENAI_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
HTTP_PORT=80
