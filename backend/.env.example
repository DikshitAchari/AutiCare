APP_NAME=AutiCare API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/auticare_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_VIDEO_UPLOAD_MB=100
AI_VIDEO_MODEL_PATH=/path/to/AI4ASD/pbr4RRB/checkpoints/RRB_LA_Net_tr_countix.checkpoint
AI_VIDEO_MODEL_COMMAND=python /path/to/AI4ASD/pbr4RRB/run_rrb_inference.py
OPENAI_API_KEY=
