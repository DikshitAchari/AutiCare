APP_NAME=AutiCare API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=postgresql://postgres@localhost:5432/auticare_db
ALLOW_SQLITE_FOR_TESTS=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_VIDEO_UPLOAD_MB=100
AI_VIDEO_MODEL_PATH=
AI_VIDEO_INFERENCE_TIMEOUT_SECONDS=1200
# Set this to a JSON array of arguments; replace the final placeholder with the local infer_video.py path.
AI_VIDEO_MODEL_COMMAND=["conda","run","-n","pbr4rrb","python","<path-to-pbr4RRB-infer_video.py>"]
OPENAI_API_KEY=

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@auticare.com
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
ALLOW_DEV_OTP_LOGGING=false
